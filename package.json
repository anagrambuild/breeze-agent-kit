{
	"name": "breeze-agent-kit",
	"private": true,
	"packageManager": "bun@1.3.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "oxlint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "turbo check",
		"test": "turbo test",
		"dev:mcp": "bun run --filter mcp dev",
		"build:mcp": "bun run --filter mcp build",
		"start:mcp": "bun run --filter mcp start",
		"check:mcp": "bun run --filter mcp check",
		"test:mcp": "bun run --filter mcp test",
		"dev:x402": "bun run --filter x402 dev",
		"build:x402": "bun run --filter x402 build",
		"start:x402": "bun run --filter x402 start",
		"check:x402": "bun run --filter x402 check",
		"test:x402": "bun run --filter x402 test",
		"e2e:x402": "bun run --filter x402 e2e",
		"dev:mpp": "bun run --filter mpp dev",
		"build:mpp": "bun run --filter mpp build",
		"start:mpp": "bun run --filter mpp start",
		"check:mpp": "bun run --filter mpp check",
		"test:mpp": "bun run --filter mpp test",
		"e2e:mpp": "bun run --filter mpp e2e",
		"dev:website": "bun run --filter website dev",
		"build:website": "bun run --filter website build",
		"start:website": "bun run --filter website start",
		"check:website": "bun run --filter website check"
	},
	"devDependencies": {
		"oxlint": "^1.0.0",
		"prettier": "^3.5.3",
		"turbo": "^2.4.4",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"@solana/spl-token": "^0.4.14",
		"@solana/web3.js": "^1.98.4",
		"@vercel/analytics": "^1.6.1"
	}
}
