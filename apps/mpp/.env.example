PORT=3403

# Breeze API
BREEZE_API_BASE_URL=https://api.breeze.baby
BREEZE_API_KEY=your-breeze-api-key

# MPP payment config
MPP_SECRET_KEY=replace-with-random-secret
MPP_PAY_TO=your-solana-wallet-address
MPP_PRICE_USDC=1000

# Solana RPC (required — public RPC is rate-limited and will fail)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# For e2e testing: base58-encoded wallet private key (must have USDC + SOL for fees)
# E2E_WALLET_PRIVATE_KEY=
